#!/bin/sh
# Git pre-commit hook: check the staged files, not the whole project.
#
# Install with:
#   ln -s ../../Examples/hooks/pre-commit .git/hooks/pre-commit
#
# Staged Swift goes through `scan --files`, which reads the whole project — a
# helper declared in a file you did not touch still decides whether the string
# you did touch is localized — but reports only on what you are committing.
# Staged catalogs go through `check`.
#
# Bypass with `git commit --no-verify` when you mean to.

set -eu

command -v xclocsmith >/dev/null 2>&1 || exit 0

staged=$(git diff --cached --name-only --diff-filter=ACM)
swift=$(printf '%s\n' "$staged" | grep '\.swift$' || true)
catalogs=$(printf '%s\n' "$staged" | grep '\.xcstrings$' || true)

status=0

# `git diff --name-only` is newline-delimited, so split on newlines only —
# the default IFS would cut "Session View.swift" in half. Globbing is off for
# the same reason: a path is a path, not a pattern.
set -f
IFS='
'

if [ -n "$swift" ]; then
    # One --files per path; the flag is repeatable.
    set --
    for file in $swift; do
        set -- "$@" --files "$file"
    done
    xclocsmith scan "$@" || status=$?
fi

if [ -n "$catalogs" ]; then
    set --
    for file in $catalogs; do
        set -- "$@" "$file"
    done
    xclocsmith check "$@" || status=$?
fi

unset IFS
set +f

if [ "$status" -ge 2 ]; then
    echo ""
    echo "xclocsmith could not run (exit $status) — that is a configuration or I/O"
    echo "problem, not a finding. Fix it, or commit with --no-verify."
elif [ "$status" -ne 0 ]; then
    echo ""
    echo "Commit stopped by xclocsmith. Fix the findings, or commit with --no-verify."
fi

exit "$status"
